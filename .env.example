# LinkVault Environment Variables
# For local development, LinkVault runs with built-in persistent storage out of the box.
# To connect your remote Supabase PostgreSQL database, fill in these values:

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Port
PORT=3000
